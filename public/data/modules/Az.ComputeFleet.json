{"module":"Az.ComputeFleet","version":"0.0.0","cmdlets":{"Get-AzComputeFleet":{"syntax":"Get-AzComputeFleet [-SubscriptionId <String[]>] [-DefaultProfile <PSObject>]\n [<CommonParameters>]","examples":["Get-AzComputeFleet -Name \"fleet1\" -ResourceGroupName \"myResourceGroup\" |\n    Select-Object Name, Location, ProvisioningState, Mode, RegularPriorityProfileCapacity, RegularPriorityProfileAllocationStrategy","Retrieves a specific Compute Fleet by name and resource group, returning its full configuration including compute profile, VM sizes, priority settings, and provisioning state."]},"Get-AzComputeFleetVirtualMachine":{"syntax":"Get-AzComputeFleetVirtualMachine -Name <String> -ResourceGroupName <String> [-SubscriptionId <String[]>]\n [-Filter <String>] [-Skiptoken <String>] [-DefaultProfile <PSObject>]\n [<CommonParameters>]","examples":["Get-AzComputeFleetVirtualMachine -Name \"fleet1\" -ResourceGroupName \"myResourceGroup\" |\n    Select-Object Name, OperationStatus","Lists the VMs launched by the fleet and their launch operation status.\nDuring provisioning, `OperationStatus` can progress through `Launching` and `Creating` before reaching `Succeeded`.\nThis is the fleet launch status, not the VM's guest operating system or power state."]},"Get-AzComputeFleetVirtualMachineScaleSet":{"syntax":"Get-AzComputeFleetVirtualMachineScaleSet -Name <String> -ResourceGroupName <String>\n [-SubscriptionId <String[]>] [-DefaultProfile <PSObject>]\n [<CommonParameters>]","examples":["Get-AzComputeFleetVirtualMachineScaleSet -Name \"managedFleet1\" -ResourceGroupName \"myResourceGroup\" |\n    Select-Object Name, OperationStatus","Lists all Virtual Machine Scale Set resources managed by the specified Compute Fleet.\nThis cmdlet is only supported for fleets in Managed mode.\nEach VMSS is named with the fleet name followed by a unique identifier."]},"New-AzComputeFleet":{"syntax":"New-AzComputeFleet -Name <String> -ResourceGroupName <String> [-SubscriptionId <String>] -Location <String>\n [-AdditionalLocationProfile <ILocationProfile[]>] [-AdditionalVirtualMachineCapabilityHibernationEnabled]\n [-AdditionalVirtualMachineCapabilityUltraSsdEnabled] [-CapacityType <String>]\n [-ComputeProfileBaseVirtualMachineProfile <IBaseVirtualMachineProfile>]\n [-ComputeProfileComputeApiVersion <String>] [-ComputeProfilePlatformFaultDomainCount <Int32>]\n [-EnableSystemAssignedIdentity] [-Mode <String>] [-PlanName <String>] [-PlanProduct <String>]\n [-PlanPromotionCode <String>] [-PlanPublisher <String>] [-PlanVersion <String>]\n [-RegularPriorityProfileAllocationStrategy <String>] [-RegularPriorityProfileCapacity <Int32>]\n [-RegularPriorityProfileMinCapacity <Int32>] [-SpotPriorityProfileAllocationStrategy <String>]\n [-SpotPriorityProfileCapacity <Int32>] [-SpotPriorityProfileEvictionPolicy <String>]\n [-SpotPriorityProfileMaintain] [-SpotPriorityProfileMaxPricePerVM <Single>]\n [-SpotPriorityProfileMinCapacity <Int32>] [-Tag <Hashtable>] [-UserAssignedIdentity <String[]>]\n [-VMAttribute <IVMAttributes>] [-VMNamePrefix <String>] [-VMSizesProfile <IVMSizeProfile[]>]\n [-Zone <String[]>] [-DefaultProfile <PSObject>] [-AsJob] [-NoWait]\n [-WhatIf] [-Confirm] [<CommonParameters>]","examples":["$resourceGroupName = \"myResourceGroup\"\n$location = \"centralus\"\n$fleetName = \"fleet1\"\n$vmNamePrefix = \"fleet1prefix\"\n$adminPassword = Read-Host \"Enter admin password\" -AsSecureString\n\n$subnetId = \"/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myResourceGroup/providers/Microsoft.Network/virtualNetworks/vnet/subnets/subnet1\"\n$nsgId = \"/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myResourceGroup/providers/Microsoft.Network/networkSecurityGroups/nsg\"\n\n$ipConfig = [Microsoft.Azure.PowerShell.Cmdlets.ComputeFleet.Models.VirtualMachineScaleSetIPConfiguration]::new()\n$ipConfig.Name = \"nic-ipConfig\"\n$ipConfig.Primary = $true\n$ipConfig.SubnetId = $subnetId\n\n$nicConfig = [Microsoft.Azure.PowerShell.Cmdlets.ComputeFleet.Models.VirtualMachineScaleSetNetworkConfiguration]::new()\n$nicConfig.Name = \"nic\"\n$nicConfig.Primary = $true\n$nicConfig.EnableAcceleratedNetworking = $false\n$nicConfig.NetworkSecurityGroupId = $nsgId\n$nicConfig.IPConfiguration = @($ipConfig)\n\n$storageProfile = [Microsoft.Azure.PowerShell.Cmdlets.ComputeFleet.Models.VirtualMachineScaleSetStorageProfile]::new()\n$storageProfile.ImageReferencePublisher = \"canonical\"\n$storageProfile.ImageReferenceOffer = \"ubuntu-24_04-lts\"\n$storageProfile.ImageReferenceSku = \"server\"\n$storageProfile.ImageReferenceVersion = \"latest\"\n$storageProfile.OSDiskCreateOption = \"fromImage\"\n$storageProfile.OSDiskCaching = \"ReadWrite\"\n$storageProfile.OSDiskOstype = \"Linux\"\n$storageProfile.ManagedDiskStorageAccountType = \"Standard_LRS\"\n\n$osProfile = [Microsoft.Azure.PowerShell.Cmdlets.ComputeFleet.Models.VirtualMachineScaleSetOSProfile]::new()\n$osProfile.AdminUsername = \"azureUser\"\n$osProfile.ComputerNamePrefix = $fleetName\n$osProfile.AdminPassword = $adminPassword\n$osProfile.LinuxConfigurationDisablePasswordAuthentication = $false\n\n$baseVMProfile = [Microsoft.Azure.PowerShell.Cmdlets.ComputeFleet.Models.BaseVirtualMachineProfile]::new()\n$baseVMProfile.StorageProfile = $storageProfile\n$baseVMProfile.OSProfile = $osProfile\n$baseVMProfile.NetworkProfileNetworkApiVersion = \"2020-11-01\"\n$baseVMProfile.NetworkProfileNetworkInterfaceConfiguration = @($nicConfig)\n$baseVMProfile.SecurityProfileSecurityType = \"TrustedLaunch\"\n$baseVMProfile.UefiSettingSecureBootEnabled = $true\n$baseVMProfile.UefiSettingVTpmEnabled = $true\n\n$vmSize1 = [Microsoft.Azure.PowerShell.Cmdlets.ComputeFleet.Models.VMSizeProfile]::new()\n$vmSize1.Name = \"Standard_D2s_v3\"\n$vmSize2 = [Microsoft.Azure.PowerShell.Cmdlets.ComputeFleet.Models.VMSizeProfile]::new()\n$vmSize2.Name = \"Standard_D8s_v3\"\n$vmSizesProfile = @($vmSize1, $vmSize2)\n\nNew-AzComputeFleet -Name $fleetName `\n    -ResourceGroupName $resourceGroupName `\n    -Location $location `\n    -Mode \"Launch\" `\n    -VMNamePrefix $vmNamePrefix `\n    -VMSizesProfile $vmSizesProfile `\n    -ComputeProfileBaseVirtualMachineProfile $baseVMProfile `\n    -ComputeProfileComputeApiVersion \"2024-11-01\" `\n    -RegularPriorityProfileCapacity 1 `\n    -RegularPriorityProfileMinCapacity 1 `\n    -RegularPriorityProfileAllocationStrategy \"LowestPrice\"","Creates a Launch mode fleet targeting one Ubuntu 24.04 LTS VM with Trusted Launch security, Standard managed disks, and no public IP address.\nReplace the subnet and network security group IDs with existing resources in the fleet's subscription and region.\nThe resource group must already exist.\n\nThe cmdlet uses the Compute Fleet API version `2026-08-01`.\n`-ComputeProfileComputeApiVersion` instead selects the Microsoft.Compute API used to provision VMs; it is not the fleet API version.\nUse `Get-AzComputeFleetVirtualMachine` to check VM launch status.\nProvisioning this example creates billable resources."]},"Remove-AzComputeFleet":{"syntax":"Remove-AzComputeFleet -Name <String> -ResourceGroupName <String> [-SubscriptionId <String>]\n [-DefaultProfile <PSObject>] [-AsJob] [-NoWait] [-PassThru] [-WhatIf]\n [-Confirm] [<CommonParameters>]","examples":["Remove-AzComputeFleet -Name \"fleet1\" -ResourceGroupName \"myResourceGroup\"","Remove-AzComputeFleet -Name \"fleet1\" -ResourceGroupName \"myResourceGroup\" -PassThru","Deletes the specified Compute Fleet and returns a boolean indicating success when the `-PassThru` switch is used."]},"Set-AzComputeFleet":{"syntax":"Set-AzComputeFleet -Name <String> -ResourceGroupName <String> [-SubscriptionId <String>] -Location <String>\n [-AdditionalLocationProfile <ILocationProfile[]>] [-AdditionalVirtualMachineCapabilityHibernationEnabled]\n [-AdditionalVirtualMachineCapabilityUltraSsdEnabled] [-CapacityType <String>]\n [-ComputeProfileBaseVirtualMachineProfile <IBaseVirtualMachineProfile>]\n [-ComputeProfileComputeApiVersion <String>] [-ComputeProfilePlatformFaultDomainCount <Int32>]\n [-EnableSystemAssignedIdentity <Boolean>] [-Mode <String>] [-PlanName <String>] [-PlanProduct <String>]\n [-PlanPromotionCode <String>] [-PlanPublisher <String>] [-PlanVersion <String>]\n [-RegularPriorityProfileAllocationStrategy <String>] [-RegularPriorityProfileCapacity <Int32>]\n [-RegularPriorityProfileMinCapacity <Int32>] [-SpotPriorityProfileAllocationStrategy <String>]\n [-SpotPriorityProfileCapacity <Int32>] [-SpotPriorityProfileEvictionPolicy <String>]\n [-SpotPriorityProfileMaintain] [-SpotPriorityProfileMaxPricePerVM <Single>]\n [-SpotPriorityProfileMinCapacity <Int32>] [-Tag <Hashtable>] [-UserAssignedIdentity <String[]>]\n [-VMAttribute <IVMAttributes>] [-VMNamePrefix <String>] [-VMSizesProfile <IVMSizeProfile[]>]\n [-Zone <String[]>] [-DefaultProfile <PSObject>] [-AsJob] [-NoWait]\n [-WhatIf] [-Confirm] [<CommonParameters>]","examples":["Set-AzComputeFleet -Name \"managedFleet1\" -ResourceGroupName \"myResourceGroup\" `\n    -Location \"centralus\" `\n    -Tag @{ environment = \"test\" } |\n    Select-Object Name, Location, Mode, Tag, ProvisioningState","Sends a PUT create-or-update request for the existing fleet.\n`-Location` is required.\nThis tag-only example omits `computeProfile`, which cannot be changed after creation.\nFor partial updates, prefer `Update-AzComputeFleet`."]},"Update-AzComputeFleet":{"syntax":"Update-AzComputeFleet -Name <String> -ResourceGroupName <String> [-SubscriptionId <String>]\n [-AdditionalLocationProfile <ILocationProfile[]>] [-AdditionalVirtualMachineCapabilityHibernationEnabled]\n [-AdditionalVirtualMachineCapabilityUltraSsdEnabled] [-CapacityType <String>]\n [-ComputeProfileBaseVirtualMachineProfile <IBaseVirtualMachineProfile>]\n [-ComputeProfileComputeApiVersion <String>] [-ComputeProfilePlatformFaultDomainCount <Int32>]\n [-EnableSystemAssignedIdentity <Boolean>] [-Mode <String>] [-PlanName <String>] [-PlanProduct <String>]\n [-PlanPromotionCode <String>] [-PlanPublisher <String>] [-PlanVersion <String>]\n [-RegularPriorityProfileAllocationStrategy <String>] [-RegularPriorityProfileCapacity <Int32>]\n [-RegularPriorityProfileMinCapacity <Int32>] [-SpotPriorityProfileAllocationStrategy <String>]\n [-SpotPriorityProfileCapacity <Int32>] [-SpotPriorityProfileEvictionPolicy <String>]\n [-SpotPriorityProfileMaintain] [-SpotPriorityProfileMaxPricePerVM <Single>]\n [-SpotPriorityProfileMinCapacity <Int32>] [-Tag <Hashtable>] [-UserAssignedIdentity <String[]>]\n [-VMAttribute <IVMAttributes>] [-VMNamePrefix <String>] [-VMSizesProfile <IVMSizeProfile[]>]\n [-Zone <String[]>] [-DefaultProfile <PSObject>] [-AsJob] [-NoWait]\n [-WhatIf] [-Confirm] [<CommonParameters>]","examples":["Update-AzComputeFleet -Name \"managedFleet1\" -ResourceGroupName \"myResourceGroup\" `\n    -Tag @{ environment = \"staging\" } |\n    Select-Object Name, Tag, ProvisioningState","Retrieves the fleet with GET using the `2026-08-01` Compute Fleet API, updates its tags, and sends the modified configuration with PUT.\nThe existing compute profile is included in the PUT request.\nTags supplied here replace the tag collection; include any existing tags you want to retain."]}}}